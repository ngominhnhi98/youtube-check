# ── MongoDB Atlas (free M0 cluster is enough) ──────────────────────────────
# Only used to persist failed-login lockouts (brute-force protection).
# Atlas -> Database -> Connect -> Drivers. Include the database name in the path.
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/youtubecheck?retryWrites=true&w=majority"

# ── App password (unlocks the tool, same idea as HealthCheck) ──────────────
# When set, the UI and the /api/run endpoint refuse to work until unlocked.
# Generate: openssl rand -base64 24
ADMIN_PASSWORD="choose-a-strong-password"

# Key used to sign session cookies. Generate: openssl rand -base64 48
# Optional — if unset, a key is derived from ADMIN_PASSWORD.
SESSION_SECRET=""

# ── YouTube Data API v3 ────────────────────────────────────────────────────
# Fallback only. Ưu tiên thêm nhiều key qua Settings (⚙️) để pool + xoay vòng.
# Google Cloud -> APIs & Services -> Credentials -> API key. Bật "YouTube Data API v3".
YOUTUBE_API_KEY=""

# ── Google OAuth (server-side, refresh token) — để ghi Google Sheet ────────
# Google Cloud -> Credentials -> OAuth client ID (Web application).
# Authorized redirect URIs:
#   http://localhost:3000/api/google/callback
#   https://<domain-vercel>/api/google/callback
# Bật Google Sheets API. OAuth consent: thêm scope .../auth/spreadsheets,
# và (khi còn Testing) thêm email của bạn vào Test users.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── (Tùy chọn) Service account — fallback nếu không đăng nhập Google ──────
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account", ...}'  # share sheet cho client_email

# ── Gemini (sinh từ khoá) ─────────────────────────────────────────────────
# Pool key, phân tách bằng dấu phẩy; mỗi mục "id:key" (id tùy chọn, chỉ để log).
GEMINI_KEYS="key-1:AIza...,key-2:AQ...."
